{
  "_说明": [
    "这是会写入 ~/.claude/settings.json 的 hooks 片段，放在这里作为参考和备份。",
    "",
    "推荐用 install-hooks.ps1 安装，它会先备份并检查冲突：",
    "    powershell -ExecutionPolicy Bypass -File <项目目录>\\install-hooks.ps1",
    "该脚本会**自己推导出** PetNotify.exe 的路径（取脚本所在目录下的 bin\\），",
    "所以 clone 到任意盘符、任意目录都能直接运行，不依赖作者机器上的 D:\\ClaudePet。",
    "需要指向别处时，用 -PetExe <路径> 覆盖。",
    "",
    "下面的路径写成「<项目目录>」占位符：本文件是**手工复制粘贴**用的模板，",
    "复制时必须把 <项目目录> 换成你自己的实际路径（例如 D:\\ClaudePet）。",
    "直接用 install-hooks.ps1 的话不需要看这份文件。",
    "",
    "命令一律用 exec 形式（command = exe 路径 + args = 状态），不要把状态拼进 command。",
    "拼成一整串的话，命令会交给 shell 解析；Git Bash 里未加引号的反斜杠是转义符，",
    "D:\\ClaudePet\\bin\\PetNotify.exe 会被吃成 D:ClaudePetbinPetNotify.exe，全部 hook 静默失效。",
    "exec 形式不经过 shell，路径里有反斜杠、空格都不要紧，也不用加引号。",
    "",
    "timeout 设 5 秒是保险值——实际单次约 60~130ms。",
    "SessionEnd 的默认超时只有 1.5 秒，这里显式放宽到 5 秒。"
  ],

  "hooks": {
    "SessionStart": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "<项目目录>\\bin\\PetNotify.exe", "args": ["awake"], "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "<项目目录>\\bin\\PetNotify.exe", "args": ["think"], "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "<项目目录>\\bin\\PetNotify.exe", "args": ["work"], "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "<项目目录>\\bin\\PetNotify.exe", "args": ["think"], "timeout": 5 } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "<项目目录>\\bin\\PetNotify.exe", "args": ["error"], "timeout": 5 } ] }
    ],
    "Notification": [
      { "matcher": "permission_prompt", "hooks": [ { "type": "command", "command": "<项目目录>\\bin\\PetNotify.exe", "args": ["alert"], "timeout": 5 } ] },
      { "matcher": "idle_prompt",       "hooks": [ { "type": "command", "command": "<项目目录>\\bin\\PetNotify.exe", "args": ["sleep"], "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "<项目目录>\\bin\\PetNotify.exe", "args": ["done"], "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "<项目目录>\\bin\\PetNotify.exe", "args": ["sleep"], "timeout": 5 } ] }
    ]
  }
}
